# ============================================================
# Hugo Post Manager 环境变量示例
# 复制为 .env 后按需填写(本机开发放在项目根目录;服务器部署放部署环境;
# 部署到 Vercel 时改在 Project → Settings → Environment Variables 里配置,
# 不要提交 .env 文件)
# ============================================================

# ------------------------------------------------------------
# AI 模型服务(unillm-sdk 统一驱动,支持 14 家主流厂商)
# 配置优先级(高 → 低):
#   前端「写作助手 → 模型服务」手动填写的 Key(localStorage)
#   > 下方 HPM_AI_* 专用变量
#   > UNILLM_* 通用变量
#   > 厂商专用变量(如 DEEPSEEK_API_KEY / OPENAI_API_KEY / GEMINI_API_KEY ...)
#   > 旧版 AI_* 变量(GENSO-GEO 等存量项目零改名迁移)
# ------------------------------------------------------------

# HPM_AI_* 是本应用专用前缀,只影响 Hugo Post Manager,不影响其他项目
# HPM_AI_PROVIDER=deepseek            # 厂商 ID:openai/anthropic/gemini/volcengine/
#                                     #   deepseek/moonshot/qwen/zhipu/xai/groq/
#                                     #   mistral/siliconflow/ollama/custom
# HPM_AI_API_KEY=sk-xxxxxxxx
# HPM_AI_MODEL=deepseek-chat
# HPM_AI_BASE_URL=https://api.deepseek.com/v1   # 可选(代理/网关)
# HPM_AI_TEMPERATURE=0.7

# 更通用的做法:直接用 unillm 标准变量(任何项目通用)
# UNILLM_PROVIDER=deepseek
# UNILLM_API_KEY=sk-xxxxxxxx
# UNILLM_MODEL=deepseek-chat
# UNILLM_BASE_URL=https://api.deepseek.com/v1

# 或者直接用厂商专用变量(最常见,一键切换厂商)
# DEEPSEEK_API_KEY=sk-xxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# GEMINI_API_KEY=xxxxxxxx           # AI Studio 部署时自动注入,同样会被识别
# MOONSHOT_API_KEY=sk-xxxxxxxx      # Kimi
# DASHSCOPE_API_KEY=sk-xxxxxxxx     # 通义千问
# ZHIPU_API_KEY=xxxxxxxx.xxxxxxxx   # 智谱 GLM
# XAI_API_KEY=xxxxxxxx              # Grok
# GROQ_API_KEY=gsk_xxxxxxxx
# SILICONFLOW_API_KEY=sk-xxxxxxxx
# VOLCENGINE_API_KEY=xxxxxxxx       # 火山方舟(豆包),需配合 VOLCENGINE_API_BASE / ARK_API_BASE

# 可选微调
# HPM_AI_MAX_TOKENS=4096
# HPM_AI_TIMEOUT_MS=120000
# HPM_AI_RETRIES=2

# ------------------------------------------------------------
# 服务本身
# ------------------------------------------------------------
# PORT: Express 服务监听端口(默认 3000)
# PORT=3000

# APP_URL: 部署后的公网地址(用于 OAuth 回调 / 自引用链接等)
# APP_URL=http://localhost:3000

# ------------------------------------------------------------
# 附:GitHub 仓库访问不需要环境变量——
#     在应用「仓库配置」里填写 Owner / Repo / PAT Token(存浏览器 localStorage)
#     公开仓库只读预览可留空 Token
# ------------------------------------------------------------
